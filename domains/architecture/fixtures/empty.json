{
  "name": "empty",
  "domain": "architecture",
  "format": "module-graph-and-adr",
  "description": "空集边界：没有模块、没有 ADR。合法结果是 0 个候选而不是抛错——「没有可审的结构」与「输入坏了」必须能被区分开。",
  "input": {
    "format": "module-graph-and-adr",
    "payload": { "modules": [], "adrs": [] }
  },
  "expect": {
    "candidates": 0,
    "paths": [],
    "admitted": 0,
    "excludedByPredicate": {},
    "bounded": true,
    "truncated": false
  },
  "anchors": {
    "positive": [
      {
        "note": "P0 空集不影响 P5：锚点层面对的是依赖图，与候选集是否为空无关。",
        "claim": {
          "kind": "module-and-adr",
          "path": "src/a.ts",
          "locator": { "kind": "dependency-edge", "path": "src/a.ts", "moduleId": "a", "targetId": "b", "findingKind": "edge" },
          "excerpt": "a -> b"
        },
        "subject": {
          "modules": [
            { "id": "a", "path": "src/a.ts", "dependsOn": ["b"], "layer": "application" },
            { "id": "b", "path": "src/b.ts", "dependsOn": [], "layer": "domain" }
          ],
          "adrs": []
        },
        "expectStatus": "anchored",
        "expectTier": "recomputed-unique"
      }
    ],
    "negative": [
      {
        "note": "没有提供任何依赖图时必须判未锚定（no-documents），绝不当作「锚点成立但无法核验」。",
        "claim": {
          "kind": "module-and-adr",
          "path": "src/a.ts",
          "locator": { "kind": "dependency-edge", "path": "src/a.ts", "moduleId": "a", "targetId": "b", "findingKind": "edge" },
          "excerpt": "a -> b"
        },
        "subject": {},
        "expectStatus": "unanchored",
        "expectTier": "no-documents"
      }
    ]
  }
}
