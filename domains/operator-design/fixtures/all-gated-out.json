          "excerpt": "void op_generated(const Tensor& x) {"
        },
        "subject": {
          "path": "generated/op.cu",
          "content": "void op_generated(const Tensor& x) {\n}\n",
          "operators": [{ "name": "op_generated", "signature": "void op_generated(const Tensor& x)", "backends": ["cuda"], "dtypes": ["fp32"], "shapeBranches": ["contiguous"] }],
          "tests": []
        },
        "expectStatus": "anchored",
        "expectTier": "recomputed-unique",
        "expectStart": 1
      }
    ],
    "negative": [
      {
        "note": "findingKind 不在本领域认得的集合里：拒绝猜测，判未锚定而不是当作一般性的边。",
        "claim": {
          "kind": "signature-and-tolerance",
          "path": "generated/op.cu",
          "locator": { "kind": "operator-form", "path": "generated/op.cu", "operator": "op_generated", "backend": "cuda", "dtype": "fp32", "shapeBranch": "contiguous", "findingKind": "performance-regression" },
