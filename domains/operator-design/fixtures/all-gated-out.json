    "payload": {
      "operators": [
        { "name": "op_vendor", "signature": "void op_vendor(const Tensor& x)", "backends": ["cuda"], "dtypes": ["fp32"], "shapeBranches": ["contiguous"], "path": "node_modules/vendor/op.cu", "source": "void op_vendor(const Tensor& x) {\n}" },
        { "name": "op_built", "signature": "void op_built(const Tensor& x)", "backends": ["cuda"], "dtypes": ["fp32"], "shapeBranches": ["contiguous"], "path": "dist/op.cu", "source": "void op_built(const Tensor& x) {\n}" },
        { "name": "op_builddir", "signature": "void op_builddir(const Tensor& x)", "backends": ["cuda"], "dtypes": ["fp32"], "shapeBranches": ["contiguous"], "path": "build/op.cu", "source": "void op_builddir(const Tensor& x) {\n}" },
        { "name": "op_hook", "signature": "void op_hook(const Tensor& x)", "backends": ["cuda"], "dtypes": ["fp32"], "shapeBranches": ["contiguous"], "path": ".git/hooks/op.cu", "source": "void op_hook(const Tensor& x) {\n}" },
        { "name": "op_generated", "signature": "void op_generated(const Tensor& x)", "backends": ["cuda"], "dtypes": ["fp32"], "shapeBranches": ["contiguous"], "path": "generated/op.cu", "source": "void op_generated(const Tensor& x) {\n}" }
      ],
      "tests": []
    }
  },
  "expect": {
