{
  "name": "empty",
  "domain": "user-feedback",
  "format": "feedback-ledger",
  "description": "空台账：没有任何反馈、决策或主题。P0 必须产出空集（合法结论），P1 全空，工作单必须说「空集本身就是结论」，而不是让模型凭空评审一份不存在的台账。",
  "input": {
    "format": "feedback-ledger",
    "payload": {
      "ledgerPath": "feedback/ledger.json",
      "feedback": [],
      "decisions": [],
      "themes": []
    }
  },
  "expect": {
    "candidates": 0,
    "paths": [],
    "admitted": 0,
    "excludedByPredicate": {},
    "bounded": true,
    "truncated": false
  },
  "anchors": {
    "positive": [
      {
        "note": "空语料下唯一成立的锚点是「拒绝」：没有台账就没有可重算的关系。",
        "claim": {
          "kind": "feedback-and-quote",
          "path": "feedback/ledger.json",
          "locator": {
            "kind": "closure-link",
            "feedbackId": "fb-1001",
            "decisionId": "dec-20"
          }
        },
        "subject": {
          "path": "feedback/ledger.json"
        },
        "expectStatus": "unanchored",
        "expectTier": "no-documents"
      }
    ],
    "negative": [
      {
        "note": "引文为空字符串永远不是锚点——没有任何可逐字比对的内容。",
        "claim": {
          "kind": "feedback-and-quote",
          "path": "feedback/ledger.json",
          "locator": {
            "kind": "quote-anchor",
            "feedbackId": "fb-1001",
            "quote": ""
          }
        },
        "subject": {
          "path": "feedback/ledger.json",
          "documents": [
            {
              "path": "feedback/ledger.json",
              "payload": {
                "feedback": [],
                "decisions": []
              }
            }
          ]
        },
        "expectStatus": "unanchored",
        "expectTier": "empty-excerpt"
      },
      {
        "note": "闭环节点为空时同样没有可核验的内容。",
        "claim": {
          "kind": "feedback-and-quote",
          "path": "feedback/ledger.json",
          "locator": {
            "kind": "closure-link",
            "feedbackId": "",
