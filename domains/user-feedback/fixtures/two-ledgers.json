      }
    ],
    "ambiguous": [
      {
        "note": "同一句原话在两份台账里各出现一次，声明只给了引文——竞争位置必须全部列出。",
        "claim": {
          "kind": "feedback-and-quote",
          "path": "feedback/alpha.json",
          "locator": {
            "kind": "quote-anchor",
            "quote": "通知中心的消息重复推送"
          }
        },
        "subject": {
          "path": "feedback/alpha.json",
          "documents": [
