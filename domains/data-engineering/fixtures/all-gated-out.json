              "content": "select order_id, amount, created_at, updated_at, channel, currency, discount_code, coupon_id, payment_method, shipping_method, billing_country, shipping_country, tax_rate, tax_amount, gross_amount, net_amount, refund_amount, settled_amount from raw.incoming left join backfill.wide_orders on raw.incoming.order_id = backfill.wide_orders.order_id"
