{
  "name": "happy-path",
  "domain": "project-management",
  "format": "task-graph",
  "description": "两条工作流（cart / search）的任务图：边与节点都齐全，无环、无孤儿、无未登记依赖目标。purpose 是给分捆与规则注入一个真实的多工作流样本 —— 同一条依赖链上的任务必须落在同一捆，否则跨任务的环无法被看见。",
  "input": {
    "format": "task-graph",
    "payload": {
      "documents": [
        {
          "path": "project/plan.json",
          "type": "task-graph",
          "meta": {
            "bytes": 4096,
            "workstream": "cart"
          },
          "payload": {
            "tasks": [
              {
                "id": "T1",
                "title": "购物车数据模型",
                "owner": "alice",
                "estimateDays": 3,
                "status": "done",
                "team": "cart"
              },
              {
                "id": "T2",
                "title": "购物车合并逻辑",
                "owner": "alice",
                "estimateDays": 5,
                "status": "doing",
                "team": "cart",
                "dependsOn": [
                  "T1"
                ]
              },
              {
                "id": "T3",
                "title": "结算页对接",
                "owner": "bob",
                "estimateDays": 4,
                "status": "todo",
                "team": "cart",
                "dependsOn": [
                  "T2"
                ]
              },
              {
                "id": "T7",
                "title": "搜索索引重建",
                "owner": "carol",
                "estimateDays": 6,
                "status": "todo",
                "team": "search",
                "dependsOn": [
                  "T1"
                ]
              },
              {
                "id": "T8",
                "title": "搜索排序调优",
                "owner": "carol",
                "estimateDays": 3,
                "status": "todo",
                "team": "search",
                "dependsOn": [
                  "T7",
                  "T1"
                ]
              }
            ],
            "milestones": [
              {
                "id": "M1",
                "title": "购物车上线",
                "due": "2026-11-30",
                "tasks": [
                  "T3"
                ]
              },
              {
                "id": "M2",
                "title": "搜索改版",
                "due": "2026-12-15",
                "tasks": [
                  "T8"
                ]
              }
            ],
            "risks": [
              {
                "id": "R1",
                "trigger": "合作方结算接口延期交付",
                "impact": "结算页无法联调，T3 阻塞",
                "mitigation": "10-15 前索取接口契约，否则切到降级方案",
                "owners": [
                  "bob"
                ]
              },
              {
                "id": "R2",
                "trigger": "索引重建耗时超过 6 小时窗口",
                "impact": "搜索改版上线时间顺延",
                "mitigation": "先在预发环境实测重建耗时，超出则拆窗",
                "owners": [
                  "carol"
                ]
              }
            ],
            "owners": [
              {
                "id": "alice",
                "name": "Alice",
                "teams": [
                  "cart"
                ]
              },
              {
                "id": "bob",
                "name": "Bob",
                "teams": [
                  "cart"
                ]
              },
              {
                "id": "carol",
                "name": "Carol",
                "teams": [
                  "search"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "candidates": 14,
    "paths": [
      "project/plan-t2-t1.json",
      "project/plan-t3-t2.json",
      "project/plan-t7-t1.json",
      "project/plan-t8-t7.json",
      "project/plan-t8-t1.json",
      "project/plan-task-t1.json",
      "project/plan-task-t2.json",
      "project/plan-task-t3.json",
      "project/plan-task-t7.json",
      "project/plan-task-t8.json",
      "project/plan-risk-r1.json",
      "project/plan-risk-r2.json",
      "project/plan-milestone-m1.json",
      "project/plan-milestone-m2.json"
