    "admitted": 14,
    "excludedByPredicate": {
      "binary": [],
      "secret": [],
      "deleted": [],
      "user-exclude": [],
      "extension": [],
      "default-path": [],
      "too-large": []
    },
    "bounded": true,
    "truncated": false,
    "bundleKeys": [
      "doc/project/plan.json",
      "ws/cart",
      "ws/search"
    ]
