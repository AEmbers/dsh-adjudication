                ]
              }
            }
          ]
        },
        "expectStatus": "anchored",
        "expectTier": "declared-locator",
        "expectPath": "project/plan.json"
      },
      {
        "note": "枚举器的里程碑卡：`milestone-entry` 断言这个里程碑存在 —— 逐字定位到 M1。",
        "claim": {
          "kind": "task-and-edge",
          "path": "project/plan.json",
          "locator": {
            "kind": "milestone-entry",
            "milestoneId": "M1",
            "tasks": [
              "T3"
            ]
          }
        },
        "subject": {
          "path": "project/plan.json",
          "documents": [
            {
              "path": "project/plan.json",
              "payload": {
                "tasks": [],
                "milestones": [
                  {
                    "id": "M1",
                    "title": "购物车上线",
                    "tasks": [
                      "T3"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "expectStatus": "anchored",
        "expectTier": "declared-locator",
        "expectPath": "project/plan.json"
