    "negative": [
      {
        "note": "段落锚与文档结构矛盾：原文找得到，但它被挂在一个不存在的标题下，必须判未锚定。",
        "claim": {
          "kind": "section-and-signature",
          "path": "generated/api.md",
          "locator": { "docPath": "generated/api.md", "anchor": "features", "claimKind": "link" },
          "excerpt": "See [the guide](./guide.md)."
        },
        "subject": {
          "path": "generated/api.md",
          "content": "See [the guide](./guide.md).\n",
          "sections": [{ "anchor": "usage" }]
