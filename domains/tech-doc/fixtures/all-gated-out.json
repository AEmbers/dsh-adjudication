          "path": "generated/api.md",
          "locator": { "docPath": "generated/api.md", "anchor": "usage", "claimKind": "link" },
          "excerpt": "See [the guide](./guide.md)."
        },
        "subject": {
          "path": "generated/api.md",
          "content": "See [the guide](./guide.md).\n",
          "sections": [{ "anchor": "usage" }]
