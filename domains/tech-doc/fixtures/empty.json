{
  "name": "empty",
  "domain": "tech-doc",
  "format": "doc-corpus-and-api-surface",
  "description": "空集边界：没有文档、没有 API surface。合法结果是 0 个候选而不是抛错——「没有可审的文档」与「输入坏了」必须能被区分开。",
  "input": {
    "format": "doc-corpus-and-api-surface",
    "payload": { "documents": [], "api": [] }
  },
  "expect": {
    "candidates": 0,
    "paths": [],
    "admitted": 0,
    "excludedByPredicate": {},
    "bounded": true,
    "truncated": false
  },
  "anchors": {
    "positive": [
      {
        "note": "P0 空集不影响 P5：锚点层面对的是原文，与候选集是否为空无关。",
        "claim": {
          "kind": "section-and-signature",
          "path": "docs/a.md",
          "locator": { "docPath": "docs/a.md", "anchor": "intro", "claimKind": "link" },
          "excerpt": "See [Options](./options.md)."
        },
        "subject": {
          "path": "docs/a.md",
          "content": "See [Options](./options.md).\n",
          "sections": [{ "anchor": "intro" }]
        },
        "expectStatus": "anchored",
        "expectTier": "recomputed-unique",
        "expectStart": 1
      }
    ],
    "negative": [
      {
        "note": "没有任何可比对文档时必须判未锚定（no-documents），绝不当作「锚点成立但无法核验」。",
        "claim": {
          "kind": "section-and-signature",
          "path": "docs/a.md",
          "locator": { "docPath": "docs/a.md", "anchor": "intro" },
          "excerpt": "See [Options](./options.md)."
        },
        "subject": { "path": "docs/a.md", "documents": [] },
        "expectStatus": "unanchored",
        "expectTier": "no-documents"
      }
    ]
  }
}
