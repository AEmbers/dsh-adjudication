{
  "name": "empty",
  "domain": "code-review",
  "format": "unified-diff",
  "description": "空 diff：没有变更。P0 必须产出空集（合法结论），P1 全空，工作单必须说「这本身就是结论」，而不是让模型凭空审核。",
  "input": {
    "format": "unified-diff",
    "payload": {
      "diff": ""
    }
  },
  "expect": {
    "candidates": 0,
    "paths": [],
    "admitted": 0,
    "excludedByPredicate": {},
    "bounded": true,
    "truncated": false
  },
  "anchors": {
    "positive": [
      {
        "note": "空输入下唯一成立的锚点是「拒绝」：没有文档就没有可重算的位置。",
        "claim": { "kind": "diff-line", "path": "src/app.ts", "locator": {}, "excerpt": "  const total = sum(items)" },
        "subject": { "path": "src/app.ts" },
        "expectStatus": "unanchored",
        "expectTier": "no-documents"
      }
    ],
    "negative": [
      {
        "note": "空 excerpt 永远不是锚点。",
        "claim": { "kind": "diff-line", "path": "src/app.ts", "locator": {} },
        "subject": { "path": "src/app.ts", "content": "" },
        "expectStatus": "unanchored",
        "expectTier": "empty-excerpt"
      }
    ]
  }
}
