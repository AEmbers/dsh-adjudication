            {
              "path": "experiments/records.json",
              "content": "{\"experiments\":[{\"id\":\"vendor/long-report\",\"metrics\":[{\"name\":\"per_class_report\",\"value\":\"{\\\"class-0001\\\": 0.912, \\\"class-0002\\\": 0.881, \\\"class-0003\\\": 0.923, \\\"class-0004\\\": 0.870, \\\"class-0005\\\": 0.901, \\\"class-0006\\\": 0.915, \\\"class-0007\\\": 0.889, \\\"class-0008\\\": 0.933, \\\"class-0009\\\": 0.877, \\\"class-0010\\\": 0.905, \\\"class-0011\\\": 0.918, \\\"class-0012\\\": 0.884, \\\"class-0013\\\": 0.926, \\\"class-0014\\\": 0.872, \\\"class-0015\\\": 0.908}\"}]}]}"
            }
          ],
          "experiments": [
            {
              "id": "vendor/long-report",
              "metrics": [
                {
                  "name": "per_class_report",
                  "value": "{\"class-0001\": 0.912, \"class-0002\": 0.881, \"class-0003\": 0.923, \"class-0004\": 0.870, \"class-0005\": 0.901, \"class-0006\": 0.915, \"class-0007\": 0.889, \"class-0008\": 0.933, \"class-0009\": 0.877, \"class-0010\": 0.905, \"class-0011\": 0.918, \"class-0012\": 0.884, \"class-0013\": 0.926, \"class-0014\": 0.872, \"class-0015\": 0.908}"
                }
              ]
            }
          ],
          "content": "{\"experiments\":[{\"id\":\"vendor/long-report\",\"metrics\":[{\"name\":\"per_class_report\",\"value\":\"{\\\"class-0001\\\": 0.912, \\\"class-0002\\\": 0.881, \\\"class-0003\\\": 0.923, \\\"class-0004\\\": 0.870, \\\"class-0005\\\": 0.901, \\\"class-0006\\\": 0.915, \\\"class-0007\\\": 0.889, \\\"class-0008\\\": 0.933, \\\"class-0009\\\": 0.877, \\\"class-0010\\\": 0.905, \\\"class-0011\\\": 0.918, \\\"class-0012\\\": 0.884, \\\"class-0013\\\": 0.926, \\\"class-0014\\\": 0.872, \\\"class-0015\\\": 0.908}\"}]}]}",
          "x-self-folded": "caller handed the payload back as a document; the engine collapses subject to {path, content, documents}"
        },
        "expectStatus": "anchored",
        "expectTier": "declared-locator",
        "expectPath": "experiments/vendor/long-report/metrics.json",
        "expectStart": 4,
        "expectCode": "metric-confirmed"
      }
    ],
    "negative": [
      {
        "note": "被 cancelled 的实验指标：锚点本身仍然可重算（值确实存在），被判未锚定的是「把它当成结论」这件事。这里用数值不符来证明结构检查先于文本检查。",
        "claim": {
          "kind": "experiment-metric",
          "path": "experiments/vision/cancelled-run/metrics.json",
          "locator": {
            "experimentId": "vision/cancelled-run",
            "metricName": "accuracy",
            "value": 0.9
          },
          "excerpt": "metric accuracy = 0.5"
        },
        "subject": {
          "path": "experiments/records.json",
          "documents": [
            {
              "path": "experiments/vision/cancelled-run/metrics.json",
              "content": "# experiment vision/cancelled-run (cancelled sweep)\nmetric accuracy = 0.5\nbaseline = (none)"
            },
            {
              "path": "experiments/records.json",
              "content": "{\"experiments\":[{\"id\":\"vision/cancelled-run\",\"metrics\":[{\"name\":\"accuracy\",\"value\":0.5}]}]}"
            }
          ],
          "experiments": [
            {
              "id": "vision/cancelled-run",
              "metrics": [
                {
                  "name": "accuracy",
                  "value": 0.5
                }
              ]
            }
          ],
          "content": "{\"experiments\":[{\"id\":\"vision/cancelled-run\",\"metrics\":[{\"name\":\"accuracy\",\"value\":0.5}]}]}",
          "x-self-folded": "caller handed the payload back as a document; the engine collapses subject to {path, content, documents}"
        },
        "expectStatus": "unanchored",
        "expectTier": "locator-mismatch",
        "expectCode": "value-mismatch"
